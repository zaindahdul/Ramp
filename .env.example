# Copy to .env and adjust. Every value has a working default for local dev,
# so the app also runs without a .env file.

# Postgres started by `docker compose up -d`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ap_credits?schema=public"

# Leave empty to run with the mock extractor (a banner shows in the app).
ANTHROPIC_API_KEY=
# Model used for document extraction.
ANTHROPIC_MODEL=claude-opus-5-5

# Where uploaded files are stored (local filesystem storage driver).
STORAGE_DIR=./storage

# Set to true when serving over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false
